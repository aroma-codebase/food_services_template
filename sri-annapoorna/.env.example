# ══════════════════════════════════════════════════
# Web3Forms — Real email delivery (FREE, no backend)
# ══════════════════════════════════════════════════
# Steps to activate:
#   1. Visit https://web3forms.com
#   2. Enter: worklancers.support@gmail.com
#   3. Click "Create Access Key"
#   4. Copy the key and paste it below
#   5. Rename this file to .env and restart the dev server
#
# Emails will be delivered to worklancers.support@gmail.com
# Check spam folder on first receipt (then mark as Not Spam)
# ══════════════════════════════════════════════════

VITE_WEB3FORMS_KEY=your_web3forms_access_key_here
